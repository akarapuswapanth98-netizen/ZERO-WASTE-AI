# ZeroWaste AI — fail-closed auth (no secrets in code or repo).
# Local demos opt in explicitly: DEMO_MODE=true (bypasses API-key checks).
# Anything else requires a REAL API_KEY here; the app refuses to start with
# the key unset or left as the public default. PRODUCTION=1 (or Vercel)
# additionally refuses DEMO_MODE=true. Copy values into real environment
# variables; do NOT commit a filled .env.
DEMO_MODE=false
API_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/zerowaste
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/zerowaste_test
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
PRODUCTION=0
AUTO_SEED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AS_OF=
